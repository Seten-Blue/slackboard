JWT_SECRET=

# Clave maestra para cifrar en reposo (AES-256-GCM) los tokens por usuario:
# acceso/refresh de Discord, botAccessToken de Slack workspaces y token de Trello.
# Generala una sola vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se define, se deriva una clave de JWT_SECRET (mas debil, solo para desarrollo).
TOKEN_ENCRYPTION_KEY=

RESEND_API_KEY=

RESEND_FROM_EMAIL=

FRONTEND_URL=http://localhost:4200

GOOGLE_CLIENT_ID=

# ===== Meta / WhatsApp Cloud API (configuracion global del desarrollador) =====
# Esta app usa UN solo token global (del desarrollador) para todas las cuentas de Whatsapp.
# En produccion, genera un System User Token permanente en el Business/
# Meta Business Manager (no el token corto de la app), con scopes minimos
# (whatsapp_business_messaging y business_management), y guardalo en un manager
# de secretos (AWS Secrets Manager, Vault, etc.) en lugar del .env.
# Para credenciales POR USUARIO (cada cliente con su propio numero de WhatsApp) se
# necesita OAuth de Meta (Facebook Login for Business -> WhatsApp Cloud API):
# un System User por cliente, ampliar el webhook callback de META_CALLBACK_URL
# y persistir el access token de cada usuario cifrado con TOKEN_ENCRYPTION_KEY.
# META_VERIFY_TOKEN es el token de verificacion del webhook, distinto del access token.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ACCOUNT_ID=
META_VERIFY_TOKEN=
META_CALLBACK_URL=
META_WEBHOOK_URL=
